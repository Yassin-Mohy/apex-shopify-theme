<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

    {{ content_for_header }}

    <style>
      :root {
        --color-background: {{ settings.color_background }};
        --color-text: {{ settings.color_text }};
        --color-text-secondary: {{ settings.color_text_secondary }};
        --color-border: {{ settings.color_border }};
        --color-button-bg: {{ settings.color_button_bg }};
        --color-button-text: {{ settings.color_button_text }};
        --color-button-outline: {{ settings.color_button_outline }};
        --color-error: #D32F2F;
        --color-success: #388E3C;
        
        --font-body-family: 'Space Grotesk', Arial, sans-serif;
        --font-heading-family: 'Space Grotesk', Arial, sans-serif;
        
        --font-body-weight: 400;
        --font-heading-weight: 700;
        --font-heading-letter-spacing: {{ settings.heading_letter_spacing }}px;

        --border-radius: {{ settings.border_radius }}px;
        --page-width: 1440px;
        --transition-default: 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'apex-theme.css' | asset_url | stylesheet_tag }}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  </head>

  <body class="template-{{ template.name }} {% if settings.enable_animations %}animations-enabled{% endif %}">
    <a class="skip-to-content-link visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t | default: 'Skip to content' }}
    </a>

    {% section 'announcement-bar' %}
    {% section 'apex-header' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'apex-footer' %}

    {%- if settings.enable_cart_drawer -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };
      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t | default: 'There was an error while updating your cart. Please try again.' }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t | default: 'You can only add [quantity] of this item to your cart.' }}`
      };
      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}`,
        soldOut: `{{ 'products.product.sold_out' | t | default: 'Sold out' }}`,
        unavailable: `{{ 'products.product.unavailable' | t | default: 'Unavailable' }}`
      };
    </script>

    <script src="{{ 'apex-theme.js' | asset_url }}" defer="defer"></script>
    {%- if settings.enable_cart_drawer -%}
      <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
