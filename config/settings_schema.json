[
  {
    "name": "theme_info",
    "theme_name": "APEX",
    "theme_author": "APEX Performance Wear",
    "theme_version": "1.0.0",
    "theme_documentation_url": "https://github.com/apex-theme",
    "theme_support_url": "https://github.com/apex-theme"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text_secondary",
        "label": "Secondary text",
        "default": "#888888"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border",
        "default": "#2A2A2A"
      },
      {
        "type": "color",
        "id": "color_button_bg",
        "label": "Primary button background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Primary button text",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_button_outline",
        "label": "Secondary button border",
        "default": "#FFFFFF"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "Heading letter spacing",
        "default": 2
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "border_radius",
        "min": 0,
        "max": 12,
        "step": 1,
        "unit": "px",
        "label": "Corner radius",
        "default": 2
      },
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "Enable fade-up animations",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_cart_drawer",
        "label": "Enable cart drawer",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold",
        "info": "Enter amount without currency symbol (e.g. 1500)",
        "default": 1500
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://instagram.com/apexwear_eg"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image"
      }
    ]
  }
]
