{%- assign product_form_id = 'product-form-' | append: section.id -%}

<section
  class="main-product page-width section-spacing"
  data-section="{{ section.id }}"
>

  <div class="product-layout">

    <!-- =========================
         LEFT COLUMN: MEDIA GALLERY
    ========================== -->

    <div class="product-media-gallery">

      {%- if product.featured_media != blank -%}

        <div class="product-gallery-wrapper">

          <div
            class="product-media-grid"
            id="MediaGrid-{{ section.id }}"
          >

            {%- for media in product.media -%}

              <div
                class="product-media-item {% if forloop.first %}is-active{% endif %}"
                data-media-id="{{ media.id }}"
              >

                {{
                  media
                  | image_url: width: 1440
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    widths: '375, 550, 750, 1100, 1440',
                    class: 'product-media-image'
                }}

              </div>

            {%- endfor -%}

          </div>

          {%- if product.media.size > 1 -%}

            <button
              type="button"
              class="product-gallery-arrow product-gallery-arrow--prev"
              aria-label="Previous image"
            >
              &#10094;
            </button>

            <button
              type="button"
              class="product-gallery-arrow product-gallery-arrow--next"
              aria-label="Next image"
            >
              &#10095;
            </button>

          {%- endif -%}

        </div>

        {%- if product.media.size > 1 -%}

          <div class="product-media-dots">

            {%- for media in product.media -%}

              <button
                type="button"
                class="media-dot {% if forloop.first %}is-active{% endif %}"
                aria-label="Go to slide {{ forloop.index }}"
                data-slide-index="{{ forloop.index0 }}"
              ></button>

            {%- endfor -%}

          </div>

        {%- endif -%}

      {%- else -%}

        <div class="product-media-item">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>

      {%- endif -%}

    </div>


    <!-- =========================
         RIGHT COLUMN: PRODUCT INFO
    ========================== -->

    <div class="product-info-sticky">

      <div class="product-meta">

        <h1 class="product-title h2">
          {{ product.title }}
        </h1>

        <div
          class="product-price-wrapper"
          id="Price-{{ section.id }}"
          role="status"
        >
          {%- render 'price', product: product -%}
        </div>

        {%- if product.compare_at_price > product.price -%}

          <div class="product-sale-badge badge badge--sale uppercase">

            Save
            {{
              product.compare_at_price
              | minus: product.price
              | times: 100
              | divided_by: product.compare_at_price
            }}%

          </div>

        {%- endif -%}

      </div>


      <!-- PRODUCT DESCRIPTION -->

      <div class="product-description rte body-text color-secondary">
        {{ product.description }}
      </div>


      <!-- =========================
           VARIANT SELECTORS
      ========================== -->

      {%- unless product.has_only_default_variant -%}

        <variant-selects
          class="no-js-hidden"
          data-section="{{ section.id }}"
          data-url="{{ product.url }}"
        >

          {%- for option in product.options_with_values -%}

            <fieldset
              class="js-product-form__input"
              data-option-index="{{ forloop.index0 }}"
            >

              <div class="option-header">

                <legend class="h6 uppercase">
                  {{ option.name }}
                </legend>

                {%- if option.name == 'Size' or option.name == 'SIZE' -%}

                  <button
                    type="button"
                    class="size-guide-trigger uppercase link-button h6"
                    aria-controls="SizeGuideModal"
                  >
                    Size Guide
                  </button>

                {%- endif -%}

              </div>


              <div class="option-values-grid">

                {%- for value in option.values -%}

                  <input
                    type="radio"
                    id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                    name="{{ option.name }}"
                    value="{{ value | escape }}"
                    form="product-form-{{ section.id }}"
                    {% if option.selected_value == value %}checked{% endif %}
                  >

                  <label
                    for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                    class="option-value-label"
                  >
                    {{ value }}
                  </label>

                {%- endfor -%}

              </div>

            </fieldset>

          {%- endfor -%}


          <script type="application/json">
            {{ product.variants | json }}
          </script>

        </variant-selects>

      {%- endunless -%}


      <!-- =========================
           PRODUCT FORM
      ========================== -->

      <product-form class="product-form-container">

        <div
          class="product-form__error-message-wrapper"
          role="alert"
          hidden
        >
          <span class="product-form__error-message"></span>
        </div>


        {%- form
          'product',
          product,
          id: product_form_id,
          class: 'form',
          novalidate: 'novalidate',
          data-type: 'add-to-cart-form'
        -%}

          <input
            type="hidden"
            name="id"
            value="{{ product.selected_or_first_available_variant.id }}"
            disabled
            class="product-variant-id"
          >


          <!-- QUANTITY -->

          <div class="product-quantity-wrapper">

            <label
              class="h6 uppercase"
              for="Quantity-{{ section.id }}"
            >
              Quantity
            </label>

            <div class="quantity-input-selector">

              <button
                type="button"
                class="quantity-btn decrement"
                aria-label="Decrease quantity"
              >
                -
              </button>

              <input
                type="number"
                name="quantity"
                id="Quantity-{{ section.id }}"
                min="1"
                value="1"
                class="quantity-field"
                form="product-form-{{ section.id }}"
              >

              <button
                type="button"
                class="quantity-btn increment"
                aria-label="Increase quantity"
              >
                +
              </button>

            </div>

          </div>


          <!-- ADD TO CART -->

          <div class="product-form__buttons">

            <button
              type="submit"
              name="add"
              class="button button--primary add-to-cart-submit button--full-width"
              {% unless product.selected_or_first_available_variant.available %}
                disabled
              {% endunless %}
            >

              <span>

                {%- if product.selected_or_first_available_variant.available -%}
                  ADD TO CART
                {%- else -%}
                  SOLD OUT
                {%- endif -%}

              </span>


              <div class="loading-overlay__spinner hidden">

                <svg
                  aria-hidden="true"
                  focusable="false"
                  role="presentation"
                  class="spinner"
                  viewBox="0 0 66 66"
                  xmlns="http://www.w3.org/2000/svg"
                >

                  <circle
                    class="path"
                    fill="none"
                    stroke-width="6"
                    cx="33"
                    cy="33"
                    r="30"
                  ></circle>

                </svg>

              </div>

            </button>


            {%- if section.settings.show_dynamic_checkout -%}
              {{ form | payment_button }}
            {%- endif -%}

          </div>

        {%- endform -%}

      </product-form>


      <!-- =========================
           ACCORDIONS
      ========================== -->

      <div class="product-accordions-group">

        <details
          id="Details-Shipping-{{ section.id }}"
          class="accordion-item"
        >

          <summary class="accordion-header">

            <span class="h5 uppercase">
              Shipping & Returns
            </span>

            {% render 'icon-chevron' %}

          </summary>

          <div class="accordion-content body-text color-secondary">

            <p>
              Fast standard shipping across Egypt within 2-5 business days.
              Returns and exchanges are accepted within 14 days of delivery
              provided the item is unworn, tag-attached, and in its original condition.
            </p>

          </div>

        </details>


        <details
          id="Details-Care-{{ section.id }}"
          class="accordion-item"
        >

          <summary class="accordion-header">

            <span class="h5 uppercase">
              Care Instructions
            </span>

            {% render 'icon-chevron' %}

          </summary>

          <div class="accordion-content body-text color-secondary">

            <p>
              Machine wash cold with like colors.
              Do not bleach.
              Tumble dry low or air dry to maintain fabric elasticity
              and compression performance.
              Do not iron branding graphics.
            </p>

          </div>

        </details>

      </div>

    </div>

  </div>


    <!-- =========================
       DYNAMIC SIZE GUIDE
  ========================== -->

  {%- assign product_title_lower = product.title | downcase -%}
  {%- assign is_pants = false -%}
  {%- assign is_sleeveless = false -%}

  {%- if product_title_lower contains 'pants' -%}
    {%- assign is_pants = true -%}
  {%- elsif product_title_lower contains 'sleeveless' -%}
    {%- assign is_sleeveless = true -%}
  {%- endif -%}


  <div
    id="SizeGuideModal"
    class="size-modal"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="SizeGuideTitle"
  >

    <div class="size-modal__overlay"></div>

    <div class="size-modal__wrapper">

      <div class="size-modal__header">

        <div>

          <span class="size-guide-eyebrow">
            APEX FIT GUIDE
          </span>

          <h3
            id="SizeGuideTitle"
            class="h3 uppercase size-guide-title"
          >
            {%- if is_pants -%}
              APEX Pants
            {%- elsif is_sleeveless -%}
              Compression Sleeveless
            {%- else -%}
              Compression T-Shirt
            {%- endif -%}
          </h3>

        </div>

        <button
          type="button"
          class="size-modal__close-btn"
          aria-label="Close size guide"
        >
          {% render 'icon-close' %}
        </button>

      </div>


      <div class="size-modal__content">


        {%- if is_pants -%}

          <!-- =========================
               APEX PANTS SIZE GUIDE
          ========================== -->

          <p class="size-guide-intro">
            Relaxed-fit APEX pants designed for comfortable movement
            and an easy everyday fit.
          </p>


          <div class="size-table-wrapper">

            <table class="size-table">

              <thead>

                <tr>
                  <th>SIZE</th>
                  <th>LENGTH</th>
                  <th>THIGH – FLAT</th>
                  <th>HEIGHT</th>
                  <th>WEIGHT</th>
                </tr>

              </thead>


              <tbody>

                <tr>
                  <td><strong>M</strong></td>
                  <td>98 cm</td>
                  <td>25 cm</td>
                  <td>165–174 cm</td>
                  <td>55–65 kg</td>
                </tr>

                <tr>
                  <td><strong>L</strong></td>
                  <td>100 cm</td>
                  <td>26 cm</td>
                  <td>172–180 cm</td>
                  <td>65–75 kg</td>
                </tr>

                <tr>
                  <td><strong>XL</strong></td>
                  <td>102 cm</td>
                  <td>27 cm</td>
                  <td>178–186 cm</td>
                  <td>75–85 kg</td>
                </tr>

                <tr>
                  <td><strong>XXL</strong></td>
                  <td>104 cm</td>
                  <td>28 cm</td>
                  <td>183–192 cm</td>
                  <td>85–100 kg</td>
                </tr>

              </tbody>

            </table>

          </div>


          <!-- HOW TO MEASURE -->

          <div class="size-guide-measurement">

            <div class="measurement-item">

              <span class="measurement-number">
                01
              </span>

              <div>

                <strong>
                  LENGTH
                </strong>

                <p>
                  Measured from the top of the waistband
                  down to the bottom hem.
                </p>

              </div>

            </div>


            <div class="measurement-item">

              <span class="measurement-number">
                02
              </span>

              <div>

                <strong>
                  THIGH – FLAT
                </strong>

                <p>
                  Measured flat across the thigh area
                  from side to side.
                </p>

              </div>

            </div>

          </div>


          <!-- FIT NOTE -->

          <div class="size-guide-note">

            <strong>
              FIT NOTE
            </strong>

            <p>
              Height and weight ranges are recommendations only.
              Body shape and preferred fit may affect your ideal size.
              If you're between sizes, choose the larger size
              for a more relaxed fit.
            </p>

          </div>



        {%- elsif is_sleeveless -%}


          <!-- =========================
               SLEEVELESS SIZE GUIDE
          ========================== -->

          <p class="size-guide-intro">
            Fitted sleeveless compression designed to sit close to the body
            while allowing full freedom of movement.
          </p>


          <div class="size-table-wrapper">

            <table class="size-table">

              <thead>

                <tr>
                  <th>SIZE</th>
                  <th>CHEST</th>
                  <th>LENGTH</th>
                  <th>HEIGHT</th>
                  <th>WEIGHT</th>
                </tr>

              </thead>


              <tbody>

                <tr>
                  <td><strong>S</strong></td>
                  <td>39 cm</td>
                  <td>60 cm</td>
                  <td>160–170 cm</td>
                  <td>50–60 kg</td>
                </tr>

                <tr>
                  <td><strong>M</strong></td>
                  <td>42.5 cm</td>
                  <td>62 cm</td>
                  <td>165–175 cm</td>
                  <td>60–70 kg</td>
                </tr>

                <tr>
                  <td><strong>L</strong></td>
                  <td>45 cm</td>
                  <td>64 cm</td>
                  <td>170–182 cm</td>
                  <td>70–82 kg</td>
                </tr>

                <tr>
                  <td><strong>XL</strong></td>
                  <td>49.5 cm</td>
                  <td>66 cm</td>
                  <td>178–190 cm</td>
                  <td>82–95 kg</td>
                </tr>

              </tbody>

            </table>

          </div>


          <!-- HOW TO MEASURE -->

          <div class="size-guide-measurement">

            <div class="measurement-item">

              <span class="measurement-number">
                01
              </span>

              <div>

                <strong>
                  CHEST
                </strong>

                <p>
                  Measured flat from armpit to armpit.
                  Multiply by 2 for the approximate full garment circumference.
                </p>

              </div>

            </div>


            <div class="measurement-item">

              <span class="measurement-number">
                02
              </span>

              <div>

                <strong>
                  LENGTH
                </strong>

                <p>
                  Measured from the highest shoulder point
                  down to the bottom hem.
                </p>

              </div>

            </div>

          </div>


          <!-- FIT NOTE -->

          <div class="size-guide-note">

            <strong>
              FIT NOTE
            </strong>

            <p>
              Height and weight ranges are recommendations only.
              Body shape and preferred compression level may affect your ideal size.
              If you're between sizes, choose the larger size
              for a slightly more relaxed fit.
            </p>

          </div>



        {%- else -%}


          <!-- =========================
               COMPRESSION T-SHIRT GUIDE
          ========================== -->

          <p class="size-guide-intro">
            Compression fit designed to sit close to the body.
            Choose your usual size for a fitted performance feel.
          </p>


          <div class="size-table-wrapper">

            <table class="size-table">

              <thead>

                <tr>
                  <th>SIZE</th>
                  <th>CHEST</th>
                  <th>LENGTH</th>
                  <th>HEIGHT</th>
                  <th>WEIGHT</th>
                </tr>

              </thead>


              <tbody>

                <tr>
                  <td><strong>S</strong></td>
                  <td>39 cm</td>
                  <td>66 cm</td>
                  <td>160–170 cm</td>
                  <td>50–60 kg</td>
                </tr>

                <tr>
                  <td><strong>M</strong></td>
                  <td>42.5 cm</td>
                  <td>68 cm</td>
                  <td>165–175 cm</td>
                  <td>60–70 kg</td>
                </tr>

                <tr>
                  <td><strong>L</strong></td>
                  <td>45 cm</td>
                  <td>70 cm</td>
                  <td>170–182 cm</td>
                  <td>70–82 kg</td>
                </tr>

                <tr>
                  <td><strong>XL</strong></td>
                  <td>49.5 cm</td>
                  <td>72 cm</td>
                  <td>178–190 cm</td>
                  <td>82–95 kg</td>
                </tr>

              </tbody>

            </table>

          </div>


          <!-- HOW TO MEASURE -->

          <div class="size-guide-measurement">

            <div class="measurement-item">

              <span class="measurement-number">
                01
              </span>

              <div>

                <strong>
                  CHEST
                </strong>

                <p>
                  Measured flat from armpit to armpit.
                  Multiply by 2 for the approximate full garment circumference.
                </p>

              </div>

            </div>


            <div class="measurement-item">

              <span class="measurement-number">
                02
              </span>

              <div>

                <strong>
                  LENGTH
                </strong>

                <p>
                  Measured from the highest shoulder point
                  down to the bottom hem.
                </p>

              </div>

            </div>

          </div>


          <!-- FIT NOTE -->

          <div class="size-guide-note">

            <strong>
              FIT NOTE
            </strong>

            <p>
              Height and weight ranges are recommendations only.
              Body shape and preferred compression level may affect your ideal size.
              If you're between sizes, choose the larger size
              for a slightly more relaxed fit.
            </p>

          </div>


        {%- endif -%}


      </div>

    </div>

  </div>

</section>



<style>

  /* =========================
     PRODUCT LAYOUT
  ========================== */

  .product-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }


  @media screen and (min-width: 990px) {

    .product-layout {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 6rem;
    }

  }


  /* =========================
     PRODUCT GALLERY
  ========================== */

  .product-gallery-wrapper {
    position: relative;
  }


  .product-media-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    gap: 1rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }


  .product-media-grid::-webkit-scrollbar {
    display: none;
  }


  @media screen and (min-width: 990px) {

    .product-media-grid {
      display: flex;
      flex-direction: row;
      overflow-x: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      gap: 0;
    }

    .product-media-item {
      flex: 0 0 100%;
    }

  }


  .product-media-item {
    flex: 0 0 100%;
    scroll-snap-align: start;
    aspect-ratio: 3 / 4;
    background-color: var(--color-border);
  }


  .product-media-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  /* =========================
     GALLERY ARROWS
  ========================== */

  .product-gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;

    width: 44px;
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid rgba(255,255,255,.35);
    border-radius: 50%;

    background: rgba(0,0,0,.45);
    color: #ffffff;

    font-size: 22px;
    line-height: 1;

    cursor: pointer;

    backdrop-filter: blur(4px);
    -webkit-tap-highlight-color: transparent;
  }


  .product-gallery-arrow--prev {
    left: 14px;
  }


  .product-gallery-arrow--next {
    right: 14px;
  }


  .product-gallery-arrow:active {
    transform: translateY(-50%) scale(.94);
  }


  @media screen and (min-width: 990px) {

    .product-gallery-arrow {
      display: flex !important;
      width: 48px;
      height: 48px;
      font-size: 22px;
    }

    .product-gallery-arrow--prev {
      left: 18px;
    }

    .product-gallery-arrow--next {
      right: 18px;
    }

    .product-media-dots {
      display: flex !important;
    }

  }


  /* =========================
     GALLERY DOTS
  ========================== */

  .product-media-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }


  .media-dot {
    width: 8px;
    height: 8px;

    padding: 0;

    border: 1px solid var(--color-text);
    background: transparent;
    border-radius: 50%;

    cursor: pointer;
  }


  .media-dot.is-active {
    background: var(--color-text);
  }


  /* =========================
     PRODUCT INFO
  ========================== */

  .product-info-sticky {
    position: relative;
  }


  @media screen and (min-width: 990px) {

    .product-info-sticky {
      position: sticky;
      top: 120px;
      height: fit-content;
    }

  }


  .product-meta {
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2.5rem;
  }


  .product-price-wrapper {
    margin: 1.5rem 0;
  }


  .product-description {
    margin-bottom: 3rem;
    font-size: 1.5rem;
    line-height: 1.6;
  }


  /* =========================
     VARIANTS
  ========================== */

  .js-product-form__input {
    border: none;
    margin-bottom: 2.5rem;
  }


  .option-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
  }


  .link-button {
    background: none;
    border: none;
    color: var(--color-text);
    text-decoration: underline;
    cursor: pointer;
  }


  .option-values-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }


  .option-values-grid input[type="radio"] {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    clip: rect(0 0 0 0);
  }


  .option-value-label {
    display: inline-block;

    border: 1px solid var(--color-border);

    padding: 1.2rem 2.5rem;

    font-size: 1.4rem;
    font-weight: 500;

    cursor: pointer;

    text-transform: uppercase;

    transition: all var(--transition-default);

    border-radius: var(--border-radius);
  }


  .option-values-grid input[type="radio"]:checked + .option-value-label {
    border-color: var(--color-text);
    background-color: var(--color-text);
    color: var(--color-background);
  }


  /* =========================
     QUANTITY
  ========================== */

  .product-quantity-wrapper {
    margin-bottom: 3rem;
  }


  .quantity-input-selector {
    display: inline-flex;

    border: 1px solid var(--color-border);

    margin-top: 1rem;

    border-radius: var(--border-radius);
  }


  .quantity-btn {
    background: transparent;
    border: none;

    width: 4.5rem;
    height: 4.5rem;

    cursor: pointer;

    font-size: 1.8rem;

    transition: color var(--transition-default);
  }


  .quantity-btn:hover {
    color: var(--color-text-secondary);
  }


  .quantity-field {
    width: 5rem;

    border: none;

    background: transparent;

    text-align: center;

    font-size: 1.4rem;

    appearance: textfield;
    -moz-appearance: textfield;
  }


  .quantity-field::-webkit-outer-spin-button,
  .quantity-field::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }


  /* =========================
     BUTTONS
  ========================== */

  .product-form__buttons {
    margin-bottom: 4rem;
  }


  .shopify-payment-button__button {
    border-radius: var(--border-radius) !important;
    font-family: var(--font-heading-family) !important;
    text-transform: uppercase !important;
    letter-spacing: .1em !important;
  }


  /* =========================
     ACCORDIONS
  ========================== */

  .product-accordions-group {
    border-top: 1px solid var(--color-border);
  }


  .accordion-item {
    border-bottom: 1px solid var(--color-border);
  }


  .accordion-header {
    display: flex;

    justify-content: space-between;
    align-items: center;

    padding: 2rem 0;

    cursor: pointer;

    list-style: none;
  }


  .accordion-header::-webkit-details-marker {
    display: none;
  }


  .accordion-header svg {
    width: 1.6rem;
    height: 1.6rem;

    transition: transform var(--transition-default);
  }


  details[open] .accordion-header svg {
    transform: rotate(180deg);
  }


  .accordion-content {
    padding-bottom: 2rem;

    line-height: 1.6;

    font-size: 1.4rem;
  }


  /* =========================
     SIZE GUIDE MODAL
  ========================== */

  .size-modal {
    position: fixed;

    inset: 0;

    width: 100%;
    height: 100%;

    z-index: 500;

    visibility: hidden;
    opacity: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 2rem;

    transition:
      visibility .25s ease,
      opacity .25s ease;
  }


  .size-modal.is-open {
    visibility: visible;
    opacity: 1;
  }


  .size-modal__overlay {
    position: absolute;
    inset: 0;

    background: rgba(0,0,0,.82);

    backdrop-filter: blur(5px);
  }


  .size-modal__wrapper {
    position: relative;

    z-index: 501;

    width: 100%;

    max-width: 900px;
    max-height: 90vh;

    overflow-y: auto;

    padding: 3.5rem;

    background: #0a0a0a;

    border: 1px solid rgba(255,255,255,.16);

    transform: translateY(20px);

    transition: transform .25s ease;
  }


  .size-modal.is-open .size-modal__wrapper {
    transform: translateY(0);
  }


  .size-modal__header {
    display: flex;

    justify-content: space-between;
    align-items: flex-start;

    gap: 2rem;

    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;

    border-bottom: 1px solid rgba(255,255,255,.12);
  }


  .size-guide-eyebrow {
    display: block;

    margin-bottom: .8rem;

    color: rgba(255,255,255,.48);

    font-size: 1rem;
    font-weight: 700;

    letter-spacing: .18em;
  }


  .size-guide-title {
    margin: 0;

    font-size: 2.8rem;

    letter-spacing: .04em;
  }


  .size-modal__close-btn {
    width: 4rem;
    height: 4rem;

    display: flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 auto;

    background: transparent;

    border: 1px solid rgba(255,255,255,.18);

    color: #fff;

    cursor: pointer;

    transition:
      background .2s ease,
      border-color .2s ease,
      color .2s ease;
  }


  .size-modal__close-btn:hover {
    background: #fff;
    color: #000;
    border-color: #fff;
  }


  .size-modal__close-btn svg {
    width: 18px;
    height: 18px;
  }


  .size-guide-intro {
    max-width: 650px;

    margin: 0 0 3rem;

    color: rgba(255,255,255,.62);

    font-size: 1.4rem;
    line-height: 1.7;
  }


  /* =========================
     SIZE TABLE
  ========================== */

  .size-table-wrapper {
    width: 100%;

    overflow-x: auto;

    border: 1px solid rgba(255,255,255,.12);

    -webkit-overflow-scrolling: touch;
  }


  .size-table {
    width: 100%;

    min-width: 700px;

    border-collapse: collapse;

    text-align: left;
  }


  .size-table th,
  .size-table td {
    padding: 1.6rem 1.5rem;

    border-bottom: 1px solid rgba(255,255,255,.1);

    white-space: nowrap;
  }


  .size-table th {
    background: rgba(255,255,255,.04);

    color: rgba(255,255,255,.52);

    font-size: 1.05rem;
    font-weight: 700;

    letter-spacing: .1em;
  }


  .size-table td {
    color: rgba(255,255,255,.82);

    font-size: 1.35rem;
  }


  .size-table tbody tr:last-child td {
    border-bottom: none;
  }


  .size-table td:first-child {
    color: #fff;

    font-size: 1.5rem;
  }


  /* =========================
     HOW TO MEASURE
  ========================== */

  .size-guide-measurement {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 1.5rem;

    margin-top: 3rem;
  }


  .measurement-item {
    display: flex;

    gap: 1.5rem;

    padding: 2rem;

    border: 1px solid rgba(255,255,255,.1);
  }


  .measurement-number {
    color: rgba(255,255,255,.35);

    font-size: 1.1rem;
    font-weight: 700;

    letter-spacing: .08em;
  }


  .measurement-item strong {
    display: block;

    margin-bottom: .7rem;

    color: #fff;

    font-size: 1.1rem;

    letter-spacing: .1em;
  }


  .measurement-item p {
    margin: 0;

    color: rgba(255,255,255,.55);

    font-size: 1.2rem;
    line-height: 1.6;
  }


  /* =========================
     FIT NOTE
  ========================== */

  .size-guide-note {
    margin-top: 2.5rem;

    padding: 2rem;

    background: rgba(255,255,255,.04);

    border-left: 2px solid #fff;
  }


  .size-guide-note strong {
    display: block;

    margin-bottom: .7rem;

    color: #fff;

    font-size: 1.05rem;

    letter-spacing: .12em;
  }


  .size-guide-note p {
    margin: 0;

    color: rgba(255,255,255,.56);

    font-size: 1.2rem;
    line-height: 1.65;
  }


  /* =========================
     MOBILE
  ========================== */

  @media screen and (max-width: 749px) {

    .product-media-grid {
      gap: 0;
    }


    .product-media-dots {
      margin-top: 1.2rem;
    }


    .product-gallery-arrow {
      width: 40px;
      height: 40px;

      font-size: 19px;
    }


    .product-gallery-arrow--prev {
      left: 10px;
    }


    .product-gallery-arrow--next {
      right: 10px;
    }


    /* SIZE GUIDE */

    .size-modal {
      padding: 1rem;
    }


    .size-modal__wrapper {
      max-height: 92vh;

      padding: 2.2rem 1.6rem;
    }


    .size-modal__header {
      margin-bottom: 2rem;

      padding-bottom: 2rem;
    }


    .size-guide-title {
      font-size: 2.2rem;
    }


    .size-guide-intro {
      margin-bottom: 2rem;

      font-size: 1.3rem;
    }


    .size-table {
      min-width: 640px;
    }


    .size-table th,
    .size-table td {
      padding: 1.3rem 1.2rem;
    }


    .size-guide-measurement {
      grid-template-columns: 1fr;
    }


    .measurement-item {
      padding: 1.6rem;
    }

  }

</style>



<script>

  document.addEventListener('DOMContentLoaded', function () {

    const section = document.querySelector(
      '.main-product[data-section="{{ section.id }}"]'
    );

    if (!section) return;


    /* =========================
       PRODUCT GALLERY
    ========================== */

    const gallery = section.querySelector('.product-media-grid');

    const slides = Array.from(
      section.querySelectorAll('.product-media-item')
    );

    const dots = Array.from(
      section.querySelectorAll('.media-dot')
    );

    const prevButton = section.querySelector(
      '.product-gallery-arrow--prev'
    );

    const nextButton = section.querySelector(
      '.product-gallery-arrow--next'
    );


    if (gallery && slides.length > 0) {

      let currentIndex = 0;


      function updateDots(index) {

        dots.forEach(function (dot, dotIndex) {

          dot.classList.toggle(
            'is-active',
            dotIndex === index
          );

        });

      }


      function goToSlide(index) {

        if (index < 0) {
          index = slides.length - 1;
        }


        if (index >= slides.length) {
          index = 0;
        }


        currentIndex = index;


        gallery.scrollTo({
          left: slides[index].offsetLeft,
          behavior: 'smooth'
        });


        updateDots(currentIndex);

      }


      if (nextButton) {

        nextButton.addEventListener('click', function () {

          goToSlide(currentIndex + 1);

        });

      }


      if (prevButton) {

        prevButton.addEventListener('click', function () {

          goToSlide(currentIndex - 1);

        });

      }


      dots.forEach(function (dot, index) {

        dot.addEventListener('click', function () {

          goToSlide(index);

        });

      });


      let scrollTimer;


      gallery.addEventListener('scroll', function () {

        clearTimeout(scrollTimer);


        scrollTimer = setTimeout(function () {

          let closestIndex = 0;

          let closestDistance = Infinity;


          slides.forEach(function (slide, index) {

            const distance = Math.abs(
              gallery.scrollLeft - slide.offsetLeft
            );


            if (distance < closestDistance) {

              closestDistance = distance;

              closestIndex = index;

            }

          });


          currentIndex = closestIndex;

          updateDots(currentIndex);

        }, 80);

      });

    }


  


    /* =========================
       SIZE GUIDE MODAL
    ========================== */

    const sizeModal = section.querySelector('#SizeGuideModal');

    const sizeGuideTriggers = section.querySelectorAll(
      '.size-guide-trigger'
    );


    if (sizeModal) {

      const sizeModalClose =
        sizeModal.querySelector('.size-modal__close-btn');

      const sizeModalOverlay =
        sizeModal.querySelector('.size-modal__overlay');


      function openSizeGuide() {

        sizeModal.classList.add('is-open');

        sizeModal.setAttribute(
          'aria-hidden',
          'false'
        );

        document.body.style.overflow = 'hidden';

      }


      function closeSizeGuide() {

        sizeModal.classList.remove('is-open');

        sizeModal.setAttribute(
          'aria-hidden',
          'true'
        );

        document.body.style.overflow = '';

      }


      sizeGuideTriggers.forEach(function (trigger) {

        trigger.addEventListener('click', function () {

          openSizeGuide();

        });

      });


      if (sizeModalClose) {

        sizeModalClose.addEventListener(
          'click',
          closeSizeGuide
        );

      }


      if (sizeModalOverlay) {

        sizeModalOverlay.addEventListener(
          'click',
          closeSizeGuide
        );

      }


      document.addEventListener('keydown', function (event) {

        if (
          event.key === 'Escape' &&
          sizeModal.classList.contains('is-open')
        ) {

          closeSizeGuide();

        }

      });

    }

  });

</script>



