<div class="main-collection page-width section-spacing fade-up">

  <div class="collection-header text-center" style="margin-bottom: 6rem;">

    <h1 class="h1 uppercase tracking-wide">
      PRODUCTS
    </h1>

    <p
      class="body-text color-secondary"
      style="max-width: 750px; margin: 2rem auto 0 auto;"
    >
      Performance wear built for training, movement, and everyday life.
      Explore the latest APEX essentials.
    </p>

  </div>


  <!-- FILTERS -->
  <div class="collection-filters-toolbar">

    <form id="CollectionFiltersForm" class="filter-form">

      <div class="filter-groups-wrap">

        {%- for filter in collection.filters -%}

          <details class="filter-disclosure-item">

            <summary class="filter-summary h6 uppercase">

              <span>
                {{ filter.label }}
              </span>

              {% render 'icon-chevron' %}

            </summary>


            <div class="filter-dropdown-content">

              {%- case filter.type -%}


                {%- when 'list' -%}

                  <ul class="filter-checkbox-list">

                    {%- for value in filter.values -%}

                      <li>

                        <label class="filter-checkbox-label body-text">

                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                          >

                          <span>
                            {{ value.label }} ({{ value.count }})
                          </span>

                        </label>

                      </li>

                    {%- endfor -%}

                  </ul>


                {%- when 'price_range' -%}

                  <div class="filter-price-range-inputs">


                    <div class="price-field-input">

                      <span>
                        Min
                      </span>

                      <input
                        name="{{ filter.min_value.param_name }}"
                        id="Filter-{{ filter.label }}-Min"
                        {% if filter.min_value.value %}
                          value="{{ filter.min_value.value | divided_by: 100 }}"
                        {% endif %}
                        type="number"
                        placeholder="0"
                      >

                    </div>


                    <div class="price-field-input">

                      <span>
                        Max
                      </span>

                      <input
                        name="{{ filter.max_value.param_name }}"
                        id="Filter-{{ filter.label }}-Max"
                        {% if filter.max_value.value %}
                          value="{{ filter.max_value.value | divided_by: 100 }}"
                        {% endif %}
                        type="number"
                        placeholder="{{ filter.range_max | divided_by: 100 }}"
                      >

                    </div>


                  </div>

              {%- endcase -%}

            </div>

          </details>

        {%- endfor -%}

      </div>


      <!-- SORT -->
      <div class="filter-sorting-wrap">

        <label
          for="SortBy"
          class="h6 uppercase color-secondary"
        >
          SORT BY
        </label>

        <select
          name="sort_by"
          id="SortBy"
          class="sort-dropdown-select uppercase"
        >

          {%- for option in collection.sort_options -%}

            <option
              value="{{ option.value }}"
              {% if option.value == collection.sort_by %}
                selected="selected"
              {% endif %}
            >
              {{ option.name }}
            </option>

          {%- endfor -%}

        </select>

      </div>

    </form>

  </div>


  <!-- PRODUCT GRID -->
  {%- paginate collection.products by 12 -%}

    {%- if collection.products_count > 0 -%}

      <div
        class="product-grid"
        id="ProductGridContainer"
        style="margin-top: 4rem;"
      >

        {%- for product in collection.products -%}

          <div class="product-grid__item fade-up">

            {% render 'product-card', product: product %}

          </div>

        {%- endfor -%}

      </div>


      {%- if paginate.pages > 1 -%}

        <div
          class="pagination-wrapper text-center"
          style="margin-top: 6rem;"
        >

          {{ paginate | default_pagination }}

        </div>

      {%- endif -%}


    {%- else -%}

      <div
        class="collection-empty-state text-center"
        style="padding: 10rem 0;"
      >

        <h3 class="h4 uppercase">
          No products match those criteria.
        </h3>

        <a
          href="{{ collection.url }}"
          class="button button--secondary"
          style="margin-top: 2rem;"
        >
          CLEAR ALL FILTERS
        </a>

      </div>

    {%- endif -%}

  {%- endpaginate -%}

</div>


<style>

  /* =========================
     COLLECTION HEADER
  ========================== */

  .collection-header {
    padding-top: 1rem;
  }

  .collection-header h1 {
    margin-bottom: 0;
  }

  .collection-header p {
    line-height: 1.7;
  }


  /* =========================
     FILTER TOOLBAR
  ========================== */

  .collection-filters-toolbar {
    display: flex;

    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);

    padding: 1.5rem 0;

    justify-content: space-between;
    align-items: center;
  }


  .filter-form {
    display: flex;

    width: 100%;

    justify-content: space-between;

    flex-wrap: wrap;

    gap: 2rem;
  }


  .filter-groups-wrap {
    display: flex;
    gap: 2.5rem;
  }


  .filter-disclosure-item {
    position: relative;
    cursor: pointer;
  }


  .filter-summary {
    display: flex;

    align-items: center;

    gap: 0.8rem;

    list-style: none;
  }


  .filter-summary::-webkit-details-marker {
    display: none;
  }


  .filter-summary svg {
    width: 14px;
    height: 14px;
  }


  /* =========================
     FILTER DROPDOWN
  ========================== */

  .filter-dropdown-content {
    position: absolute;

    top: calc(100% + 1rem);
    left: 0;

    background-color: #111;

    border: 1px solid var(--color-border);

    padding: 2rem;

    min-width: 240px;

    z-index: 50;

    border-radius: var(--border-radius);
  }


  .filter-checkbox-list {
    display: flex;

    flex-direction: column;

    gap: 1rem;

    list-style: none;

    padding: 0;
    margin: 0;
  }


  .filter-checkbox-label {
    display: flex;

    align-items: center;

    gap: 1rem;

    cursor: pointer;

    font-size: 1.4rem;
  }


  /* =========================
     PRICE FILTER
  ========================== */

  .filter-price-range-inputs {
    display: flex;

    gap: 1.5rem;
  }


  .price-field-input {
    display: flex;

    flex-direction: column;

    gap: .4rem;
  }


  .price-field-input span {
    font-size: 1.1rem;

    color: var(--color-text-secondary);

    text-transform: uppercase;
  }


  .price-field-input input {
    background: transparent;

    border: 1px solid var(--color-border);

    color: #FFF;

    padding: 0.8rem;

    width: 80px;

    border-radius: var(--border-radius);
  }


  /* =========================
     SORT
  ========================== */

  .filter-sorting-wrap {
    display: flex;

    align-items: center;

    gap: 1.5rem;
  }


  .sort-dropdown-select {
    background: transparent;

    border: 1px solid var(--color-border);

    color: #FFF;

    padding: 0.8rem 2rem;

    font-family: var(--font-heading-family);

    font-size: 1.2rem;

    border-radius: var(--border-radius);

    cursor: pointer;
  }


  /* =========================
     PRODUCT GRID
  ========================== */

  .product-grid {
    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 3rem 2rem;

    width: 100%;

    align-items: start;
  }


  .product-grid__item {
    width: 100%;

    min-width: 0;

    overflow: hidden;
  }


  .product-grid__item > * {
    width: 100%;

    max-width: 100%;
  }


  /*
    FIX PRODUCT MEDIA

    Keeps every product image inside
    the same portrait frame.

    Also prevents secondary/hover images
    from appearing below the card.
  */

  .product-grid__item .product-card__media,
  .product-grid__item .product-card__image,
  .product-grid__item .card__media,
  .product-grid__item .card-media,
  .product-grid__item .media {
    position: relative;

    width: 100%;

    aspect-ratio: 4 / 5;

    overflow: hidden;

    background: #111;
  }


  /*
    Force ALL images inside the product
    media area to occupy the same frame.
  */

  .product-grid__item .product-card__media img,
  .product-grid__item .product-card__image img,
  .product-grid__item .card__media img,
  .product-grid__item .card-media img,
  .product-grid__item .media img {
    position: absolute;

    inset: 0;

    display: block;

    width: 100%;
    height: 100%;

    max-width: 100%;

    object-fit: cover;

    object-position: center;

    margin: 0;
  }


  /*
    General fallback for themes where
    product-card does not use the wrappers above.
  */

  .product-grid__item img {
    display: block;

    max-width: 100%;
  }


  /*
    Stops a second product image / hover image
    from expanding the height of the card.
  */

  .product-grid__item picture,
  .product-grid__item .product-card__media picture,
  .product-grid__item .card__media picture,
  .product-grid__item .media picture {
    display: block;

    width: 100%;
    height: 100%;
  }


  .product-grid__item picture img {
    width: 100%;
    height: 100%;

    object-fit: cover;
  }


  /* =========================
     PAGINATION
  ========================== */

  .pagination-wrapper a,
  .pagination-wrapper span {
    padding: 1rem 1.5rem;

    border: 1px solid var(--color-border);

    margin: 0 0.4rem;

    font-size: 1.4rem;

    border-radius: var(--border-radius);
  }


  .pagination-wrapper .page.current {
    background-color: var(--color-text);

    color: var(--color-background);
  }


  /* =========================
     TABLET
  ========================== */

  @media screen and (max-width: 990px) {

    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));

      gap: 2rem 1.5rem;
    }

  }


  /* =========================
     MOBILE
  ========================== */

  @media screen and (max-width: 600px) {

    .collection-header {
      margin-bottom: 3rem !important;
    }


    .collection-header h1 {
      font-size: 3.6rem;
    }


    .collection-header p {
      font-size: 1.3rem;
    }


    .collection-filters-toolbar {
      padding: 1.2rem 0;
    }


    .filter-form {
      gap: 1.5rem;
    }


    .filter-groups-wrap {
      width: 100%;

      gap: 1.5rem;
    }


    .filter-sorting-wrap {
      width: 100%;

      justify-content: space-between;
    }


    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));

      gap: 1.5rem 1rem;

      margin-top: 2.5rem !important;
    }

  }

</style>


<script>

  document.addEventListener('DOMContentLoaded', () => {

    const filterForm =
      document.getElementById('CollectionFiltersForm');


    if (!filterForm) return;


    filterForm.addEventListener('change', () => {

      const formData =
        new FormData(filterForm);


      const searchParams =
        new URLSearchParams(formData).toString();


      window.location.search =
        searchParams;

    });

  });

</script>