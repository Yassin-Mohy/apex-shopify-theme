<div class="editorial-gallery section-spacing">
  <div class="page-width">
    
    <div class="gallery-grid">
      {%- for block in section.blocks -%}
        <div class="gallery-item gallery-item--{{ block.type }} fade-up delay-{{ forloop.index }}">
          <a href="{{ block.settings.link }}" class="gallery-item__link image-zoom-container">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 1200 }}" 
                   alt="{{ block.settings.heading | escape }}"
                   loading="lazy"
                   class="gallery-item__image">
            {%- else -%}
              <div class="placeholder-background">
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
            
            <div class="gallery-item__overlay" style="background-color: rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by: 100.0 }});">
              <div class="gallery-item__content text-{{ block.settings.text_alignment }}">
                {%- if block.settings.label != blank -%}
                  <span class="h6 color-secondary">{{ block.settings.label | escape }}</span>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="h2">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
              </div>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media screen and (min-width: 750px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-flow: dense;
    }
    .gallery-item--wide {
      grid-column: span 2;
    }
  }
  .gallery-item {
    position: relative;
    border-radius: var(--border-radius);
    overflow: hidden;
  }
  .gallery-item--portrait {
    aspect-ratio: 4/5;
  }
  .gallery-item--wide {
    aspect-ratio: 16/9;
  }
  @media screen and (max-width: 749px) {
    .gallery-item--wide, .gallery-item--portrait {
      aspect-ratio: 1/1;
    }
  }
  .gallery-item__link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .gallery-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery-item__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    padding: 4rem;
    transition: background-color var(--transition-default);
  }
  .gallery-item__link:hover .gallery-item__overlay {
    background-color: rgba(0,0,0,0.4) !important;
  }
  .gallery-item__content {
    width: 100%;
    align-self: flex-end;
  }
</style>

{% schema %}
{
  "name": "Editorial Gallery",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "wide",
      "name": "Wide Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "THE ASCENT"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "ENGINEERED TO MOVE"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 10,
          "unit": "%",
          "label": "Overlay opacity",
          "default": 30
        },
        {
          "type": "select",
          "id": "text_alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left",
          "label": "Text alignment"
        }
      ]
    },
    {
      "type": "portrait",
      "name": "Portrait Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "COMPRESSION SERIES"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "BUILT FOR YOUR PEAK"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 10,
          "unit": "%",
          "label": "Overlay opacity",
          "default": 30
        },
        {
          "type": "select",
          "id": "text_alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left",
          "label": "Text alignment"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Gallery",
      "blocks": [
        { "type": "wide" },
        { "type": "portrait" },
        { "type": "portrait" },
        { "type": "wide" }
      ]
    }
  ]
}
{% endschema %}
