<div id="CartDrawer" class="cart-drawer" aria-hidden="true" role="dialog" tabindex="-1">

  <div class="cart-drawer__overlay"></div>

  <div class="cart-drawer__wrapper">

    <!-- HEADER -->
    <div class="cart-drawer__header">

      <h3 class="h4 uppercase">
        YOUR CART
      </h3>

      <button
        type="button"
        class="cart-drawer__close-btn"
        aria-label="Close cart drawer"
      >
        {% render 'icon-close' %}
      </button>

    </div>


    <!-- FREE SHIPPING TRACKER -->
    <div
      class="cart-drawer__shipping-tracker"
      data-threshold="{{ settings.free_shipping_threshold }}"
    >

      <p
        class="shipping-tracker__message h6 text-center uppercase"
        id="ShippingTrackerMessage"
      ></p>

      <div class="shipping-tracker__bar">

        <div
          class="shipping-tracker__progress"
          id="ShippingTrackerProgress"
        ></div>

      </div>

    </div>


    <!-- CART CONTENT -->
    <div
      class="cart-drawer__content-dynamic"
      id="CartDrawerItems"
    >

      {%- if cart.item_count > 0 -%}


        <!-- ITEMS -->
        <div class="cart-drawer__items-list">

          {%- for item in cart.items -%}

            <div
              class="cart-item-row"
              data-variant-id="{{ item.variant_id }}"
              data-key="{{ item.key }}"
            >

              <!-- PRODUCT IMAGE -->
              <div class="cart-item-row__media">

                {%- if item.image != blank -%}

                  <img
                    src="{{ item.image | image_url: width: 220 }}"
                    alt="{{ item.product.title | escape }}"
                    class="cart-item-row__img"
                    loading="lazy"
                  >

                {%- endif -%}

              </div>


              <!-- PRODUCT DETAILS -->
              <div class="cart-item-row__details">

                <a
                  href="{{ item.url }}"
                  class="h6 uppercase cart-item-row__title"
                >
                  {{ item.product.title }}
                </a>


                {%- unless item.product.has_only_default_variant -%}

                  <p class="body-text color-secondary variant-title">
                    {{ item.options_with_values | map: 'value' | join: ' / ' }}
                  </p>

                {%- endunless -%}


                <p class="body-text price-field">
                  {{ item.final_line_price | money }}
                </p>


                <!-- QUANTITY -->
                <div class="cart-item-row__qty-controls">

                  <div class="quantity-input-selector mini-qty">

                    <button
                      type="button"
                      class="qty-change-btn dec"
                      data-action="decrement"
                      aria-label="Decrease quantity"
                    >
                      −
                    </button>


                    <input
                      type="number"
                      value="{{ item.quantity }}"
                      min="0"
                      class="qty-input"
                      readonly
                    >


                    <button
                      type="button"
                      class="qty-change-btn inc"
                      data-action="increment"
                      aria-label="Increase quantity"
                    >
                      +
                    </button>

                  </div>


                  <button
                    type="button"
                    class="cart-item-row__remove text-underline uppercase body-text"
                    data-action="remove"
                  >
                    REMOVE
                  </button>

                </div>

              </div>

            </div>

          {%- endfor -%}

        </div>


        <!-- CART FOOTER -->
        <div class="cart-drawer__footer">

          <div class="cart-drawer__subtotal-row">

            <span class="h5 uppercase">
              SUBTOTAL
            </span>

            <span class="h4" id="CartDrawerSubtotal">
              {{ cart.total_price | money }}
            </span>

          </div>


          <p class="body-text color-secondary cart-drawer__checkout-note">
            Shipping and taxes calculated at checkout.
          </p>


          <!-- DIRECT CHECKOUT -->
          <a
            href="/checkout"
            class="button button--primary button--full-width h5 cart-drawer__checkout-link"
          >
            CHECKOUT
          </a>


          <!-- ALL PRODUCTS -->
          <a
            href="/collections/all"
            class="cart-drawer__continue-shopping button button--secondary button--full-width h5"
          >
            CONTINUE SHOPPING
          </a>

        </div>


      {%- else -%}


        <!-- EMPTY CART -->
        <div class="cart-drawer__empty">

          <div class="cart-drawer__empty-inner">

            <p class="cart-drawer__empty-eyebrow">
              APEX
            </p>

            <h3 class="cart-drawer__empty-title">
              YOUR CART IS EMPTY.
            </h3>

            <p class="cart-drawer__empty-text">
              Explore our latest products and find your next essential.
            </p>

            <a
              href="/collections/all"
              class="button button--primary cart-drawer__shop-button"
            >
              SHOP NOW
            </a>

          </div>

        </div>


      {%- endif -%}

    </div>

  </div>

</div>



<style>

  /* =========================
     CART DRAWER
  ========================== */

  .cart-drawer {
    position: fixed;

    top: 0;
    left: 0;

    width: 100%;
    height: 100%;

    z-index: 600;

    visibility: hidden;

    transition: visibility 0.4s;
  }


  .cart-drawer.is-open {
    visibility: visible;
  }



  /* =========================
     OVERLAY
  ========================== */

  .cart-drawer__overlay {
    position: absolute;

    inset: 0;

    background-color: rgba(0, 0, 0, 0.72);

    opacity: 0;

    transition: opacity 0.4s ease;
  }


  .cart-drawer.is-open .cart-drawer__overlay {
    opacity: 1;
  }



  /* =========================
     WRAPPER
  ========================== */

  .cart-drawer__wrapper {
    position: absolute;

    top: 0;
    right: 0;

    width: 100%;
    max-width: 460px;

    height: 100%;

    background-color: #0A0A0A;

    border-left: 1px solid var(--color-border);

    box-shadow: -4px 0 20px rgba(0,0,0,0.5);

    transform: translateX(100%);

    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);

    display: flex;
    flex-direction: column;

    z-index: 601;
  }


  .cart-drawer.is-open .cart-drawer__wrapper {
    transform: translateX(0);
  }



  /* =========================
     HEADER
  ========================== */

  .cart-drawer__header {
    display: flex;

    justify-content: space-between;
    align-items: center;

    padding: 2.4rem 2.5rem;

    border-bottom: 1px solid var(--color-border);
  }


  .cart-drawer__header h3 {
    margin: 0;

    font-size: 2rem;

    letter-spacing: .08em;
  }


  .cart-drawer__close-btn {
    width: 40px;
    height: 40px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: none;

    border: none;

    cursor: pointer;

    color: inherit;

    padding: 0;
  }


  .cart-drawer__close-btn svg {
    width: 20px;
    height: 20px;
  }



  /* =========================
     SHIPPING TRACKER
  ========================== */

  .cart-drawer__shipping-tracker {
    padding: 1.5rem 2.5rem 1.7rem;

    border-bottom: 1px solid var(--color-border);

    background-color: #111;
  }


  .shipping-tracker__message {
    margin: 0 0 1rem;

    font-size: 1.15rem;

    letter-spacing: .05em;

    line-height: 1.4;
  }


  .shipping-tracker__bar {
    width: 100%;
    height: 4px;

    background-color: var(--color-border);

    border-radius: 2px;

    overflow: hidden;
  }


  .shipping-tracker__progress {
    height: 100%;
    width: 0%;

    background-color: var(--color-text);

    transition: width 0.4s ease;
  }



  /* =========================
     CONTENT
  ========================== */

  .cart-drawer__content-dynamic {
    flex: 1;

    overflow-y: auto;

    padding: 2.5rem;

    display: flex;
    flex-direction: column;
  }



  /* =========================
     ITEMS
  ========================== */

  .cart-drawer__items-list {
    flex: 1;

    display: flex;
    flex-direction: column;

    gap: 2.5rem;
  }


  .cart-item-row {
    display: grid;

    grid-template-columns: 80px minmax(0, 1fr);

    gap: 1.6rem;

    align-items: flex-start;
  }


  .cart-item-row__media {
    aspect-ratio: 3 / 4;

    background-color: var(--color-border);

    border-radius: var(--border-radius);

    overflow: hidden;
  }


  .cart-item-row__img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }


  .cart-item-row__details {
    min-width: 0;

    display: flex;
    flex-direction: column;

    gap: .45rem;
  }


  .cart-item-row__title {
    color: #fff;

    font-size: 1.3rem;

    line-height: 1.35;

    letter-spacing: .05em;

    text-decoration: none;
  }


  .variant-title {
    margin: 0;

    font-size: 1.15rem;
  }


  .price-field {
    margin: .2rem 0 .5rem;

    font-size: 1.25rem;
  }



  /* =========================
     QUANTITY CONTROLS
  ========================== */

  .cart-item-row__qty-controls {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 1rem;

    margin-top: .4rem;
  }


  .mini-qty {
    display: flex;

    align-items: center;

    margin-top: 0;

    border: 1px solid var(--color-border);
  }


  .mini-qty .quantity-btn,
  .mini-qty .qty-change-btn {
    width: 3.4rem;
    height: 3.4rem;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 1.4rem;

    background: none;

    border: none;

    color: #fff;

    cursor: pointer;
  }


  .mini-qty .qty-input {
    width: 3.2rem;
    height: 3.4rem;

    padding: 0;

    font-size: 1.2rem;

    border: none;

    text-align: center;

    background: transparent;

    color: #fff;

    appearance: textfield;
  }


  .mini-qty .qty-input::-webkit-inner-spin-button,
  .mini-qty .qty-input::-webkit-outer-spin-button {
    appearance: none;
    margin: 0;
  }


  .cart-item-row__remove {
    background: none;

    border: none;

    padding: 0;

    cursor: pointer;

    color: var(--color-text-secondary);

    text-decoration: underline;

    text-underline-offset: 3px;

    font-size: 1rem;
  }



  /* =========================
     FOOTER
  ========================== */

  .cart-drawer__footer {
    margin-top: 3rem;

    padding-top: 2.5rem;

    border-top: 1px solid var(--color-border);
  }


  .cart-drawer__subtotal-row {
    display: flex;

    justify-content: space-between;
    align-items: center;

    margin-bottom: 1.2rem;
  }


  .cart-drawer__checkout-note {
    margin: 0 0 2rem;

    text-align: center;

    text-transform: uppercase;

    font-size: 1rem;

    line-height: 1.5;

    letter-spacing: .04em;
  }


  .cart-drawer__checkout-link {
    display: flex;

    align-items: center;
    justify-content: center;

    text-decoration: none;
  }


  .cart-drawer__continue-shopping {
    display: flex;

    align-items: center;
    justify-content: center;

    margin-top: 1rem;

    text-decoration: none;
  }



  /* =========================
     EMPTY CART
  ========================== */

  .cart-drawer__empty {
    flex: 1;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 5rem 1rem;
  }


  .cart-drawer__empty-inner {
    width: 100%;

    max-width: 330px;

    margin: 0 auto;

    text-align: center;
  }


  .cart-drawer__empty-eyebrow {
    margin: 0 0 1.2rem;

    color: rgba(255,255,255,.38);

    font-size: 1rem;

    font-weight: 700;

    letter-spacing: .25em;
  }


  .cart-drawer__empty-title {
    margin: 0;

    color: #fff;

    font-size: 2.5rem;

    line-height: 1.15;

    letter-spacing: .07em;

    text-transform: uppercase;
  }


  .cart-drawer__empty-text {
    max-width: 290px;

    margin: 1.5rem auto 0;

    color: var(--color-text-secondary);

    font-size: 1.3rem;

    line-height: 1.65;
  }


  .cart-drawer__shop-button {
    min-width: 200px;

    margin-top: 2.8rem;

    text-decoration: none;
  }



  /* =========================
     MOBILE
  ========================== */

  @media screen and (max-width: 749px) {

    .cart-drawer__wrapper {
      max-width: 100%;
    }


    .cart-drawer__header {
      padding: 2rem;
    }


    .cart-drawer__header h3 {
      font-size: 1.8rem;
    }


    .cart-drawer__shipping-tracker {
      padding: 1.4rem 2rem 1.6rem;
    }


    .cart-drawer__content-dynamic {
      padding: 2rem;
    }


    .cart-item-row {
      grid-template-columns: 72px minmax(0, 1fr);

      gap: 1.4rem;
    }


    .cart-drawer__empty {
      padding: 4rem 1rem;
    }


    .cart-drawer__empty-title {
      font-size: 2.2rem;
    }


    .cart-drawer__empty-text {
      font-size: 1.2rem;
    }

  }

</style>