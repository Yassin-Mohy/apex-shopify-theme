<header class="apex-header" id="ApexHeader">

  <div class="apex-header__container">

    <div class="apex-header__inner">


      <!-- MOBILE MENU BUTTON -->
      <button
        type="button"
        class="apex-header__icon apex-header__menu-button"
        aria-controls="ApexMobileMenu"
        aria-expanded="false"
        aria-label="Open menu"
      >
        {% render 'icon-menu' %}
      </button>


      <!-- LOGO -->
      <a
        href="{{ routes.root_url }}"
        class="apex-header__logo"
      >

        {%- if section.settings.logo != blank -%}

          {{
            section.settings.logo
            | image_url: width: 800
            | image_tag:
              class: 'apex-header__logo-image',
              widths: '160, 240, 320, 480, 640, 800',
              alt: 'APEX',
              loading: 'eager'
          }}

        {%- else -%}

          <span class="apex-header__logo-text">
            {{ shop.name | upcase }}
          </span>

        {%- endif -%}

      </a>


      <!-- DESKTOP NAVIGATION -->
      <nav
        class="apex-header__nav"
        aria-label="Main navigation"
      >

        <ul class="apex-header__nav-list">

          {%- for link in section.settings.menu.links -%}

            <li class="apex-header__nav-item">

              <a
                href="{{ link.url }}"
                class="apex-header__nav-link {% if link.current or link.active %}is-active{% endif %}"
              >
                {{ link.title | escape }}
              </a>

            </li>

          {%- endfor -%}

        </ul>

      </nav>


      <!-- HEADER ACTIONS -->
      <div class="apex-header__actions">


        <!-- SEARCH -->
        <a
          href="{{ routes.search_url }}"
          class="apex-header__icon"
          aria-label="Search"
        >
          {% render 'icon-search' %}
        </a>


        <!-- ACCOUNT -->
        <a
          href="{{ routes.account_url }}"
          class="apex-header__icon apex-header__account"
          aria-label="Account"
        >
          {% render 'icon-account' %}
        </a>


        <!-- CART -->
        <a
          href="{{ routes.cart_url }}"
          class="apex-header__icon apex-header__cart"
          id="cart-icon-bubble"
          aria-label="Cart"
        >

          {% render 'icon-cart' %}

          <span
            id="ApexCartCount"
            class="apex-header__cart-count {% if cart.item_count == 0 %}is-hidden{% endif %}"
            aria-live="polite"
          >
            {{ cart.item_count }}
          </span>

        </a>


      </div>

    </div>

  </div>

</header>



<!-- =========================
     MOBILE MENU
========================== -->

<div
  id="ApexMobileMenu"
  class="apex-mobile-menu"
  aria-hidden="true"
>

  <div class="apex-mobile-menu__top">


    <!-- MOBILE LOGO -->
    <a
      href="{{ routes.root_url }}"
      class="apex-mobile-menu__logo"
    >

      {%- if section.settings.logo != blank -%}

        {{
          section.settings.logo
          | image_url: width: 800
          | image_tag:
            class: 'apex-mobile-menu__logo-image',
            widths: '160, 240, 320, 480, 640, 800',
            alt: 'APEX'
        }}

      {%- else -%}

        <span class="apex-header__logo-text">
          {{ shop.name | upcase }}
        </span>

      {%- endif -%}

    </a>


    <!-- CLOSE -->
    <button
      type="button"
      class="apex-header__icon apex-mobile-menu__close"
      aria-label="Close menu"
    >
      {% render 'icon-close' %}
    </button>

  </div>


  <!-- MOBILE NAVIGATION -->
  <nav
    class="apex-mobile-menu__nav"
    aria-label="Mobile navigation"
  >

    <ul class="apex-mobile-menu__list">

      {%- for link in section.settings.menu.links -%}

        <li class="apex-mobile-menu__item">

          <a
            href="{{ link.url }}"
            class="apex-mobile-menu__link {% if link.current or link.active %}is-active{% endif %}"
          >
            {{ link.title | escape }}
          </a>

        </li>

      {%- endfor -%}

    </ul>

  </nav>


  <div class="apex-mobile-menu__footer">

    <a
      href="{{ routes.account_url }}"
      class="apex-mobile-menu__account"
    >
      ACCOUNT
    </a>

  </div>

</div>



<style>

/* =========================
   HEADER
========================== */

.apex-header {
  position: relative;

  width: 100%;
  height: 84px;

  display: flex;
  align-items: center;

  background: #000000;
  color: #ffffff;

  border-bottom: 1px solid var(--color-border, #222);

  z-index: 100;
}


.apex-header__container {
  width: 100%;

  max-width: 1500px;

  margin: 0 auto;

  padding: 0 48px;
}


.apex-header__inner {
  width: 100%;

  min-height: 84px;

  display: grid;

  grid-template-columns: 1fr auto 1fr;

  align-items: center;

  column-gap: 40px;
}



/* =========================
   LOGO
========================== */

.apex-header__logo {
  display: flex;

  align-items: center;

  justify-self: start;

  color: inherit;

  text-decoration: none;

  line-height: 0;

  min-width: 0;
}


.apex-header__logo-image {
  display: block;

  width: {{ section.settings.logo_width }}px;

  height: auto;

  max-width: none;
  max-height: 72px;

  object-fit: contain;
}


.apex-header__logo-text {
  display: block;

  color: #ffffff;

  font-size: 28px;
  font-weight: 700;

  line-height: 1;

  letter-spacing: .25em;

  text-transform: uppercase;
}



/* =========================
   NAVIGATION
========================== */

.apex-header__nav {
  display: block;

  justify-self: center;
}


.apex-header__nav-list {
  list-style: none;

  display: flex;

  align-items: center;
  justify-content: center;

  gap: clamp(28px, 3vw, 54px);

  padding: 0;
  margin: 0;
}


.apex-header__nav-item {
  padding: 0;
  margin: 0;
}


.apex-header__nav-link {
  position: relative;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-height: 44px;

  color: #ffffff;

  text-decoration: none;

  white-space: nowrap;

  font-size: 13px;
  font-weight: 600;

  line-height: 1;

  letter-spacing: .1em;

  text-transform: uppercase;

  transition: opacity .25s ease;
}


.apex-header__nav-link:hover {
  opacity: .75;
}


.apex-header__nav-link::after {
  content: '';

  position: absolute;

  left: 0;
  bottom: 8px;

  width: 0;
  height: 2px;

  background: #ffffff;

  transition: width .25s ease;
}


.apex-header__nav-link:hover::after,
.apex-header__nav-link.is-active::after {
  width: 100%;
}



/* =========================
   ACTIONS
========================== */

.apex-header__actions {
  justify-self: end;

  display: flex;

  align-items: center;
  justify-content: flex-end;

  gap: 16px;
}


.apex-header__icon {
  position: relative;

  width: 44px;
  height: 44px;

  padding: 0;

  border: 0;

  background: transparent;

  color: #ffffff;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  cursor: pointer;

  text-decoration: none;

  transition: opacity .25s ease;
}


.apex-header__icon:hover {
  opacity: .7;
}


.apex-header__icon svg {
  width: 22px;
  height: 22px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.5;
}



/* =========================
   CART COUNT
========================== */

.apex-header__cart {
  position: relative;
}


.apex-header__cart-count {
  position: absolute;

  top: 1px;
  right: 0;

  display: flex;

  align-items: center;
  justify-content: center;

  min-width: 18px;
  height: 18px;

  padding: 0 4px;

  border-radius: 50px;

  background: #ffffff;
  color: #000000;

  border: 2px solid #000000;

  box-sizing: border-box;

  font-size: 10px;
  font-weight: 800;

  line-height: 1;

  pointer-events: none;

  z-index: 5;
}


.apex-header__cart-count.is-hidden {
  display: none;
}



/* =========================
   MOBILE MENU BUTTON
========================== */

.apex-header__menu-button {
  display: none;
}



/* =========================
   MOBILE MENU
========================== */

.apex-mobile-menu {
  position: fixed;

  inset: 0;

  width: 100%;
  height: 100dvh;

  padding: 24px;

  box-sizing: border-box;

  background: #000000;

  color: #ffffff;

  z-index: 999;

  display: flex;

  flex-direction: column;

  visibility: hidden;

  opacity: 0;

  transform: translateY(-20px);

  pointer-events: none;

  transition:
    opacity .3s ease,
    transform .3s ease,
    visibility .3s ease;
}


.apex-mobile-menu.is-open {
  visibility: visible;

  opacity: 1;

  transform: translateY(0);

  pointer-events: auto;
}


.apex-mobile-menu__top {
  display: flex;

  justify-content: space-between;
  align-items: center;

  min-height: 56px;

  padding-bottom: 18px;

  border-bottom: 1px solid var(--color-border, #222);
}


.apex-mobile-menu__logo {
  display: inline-flex;

  align-items: center;

  line-height: 0;
}


.apex-mobile-menu__logo-image {
  display: block;

  width: min({{ section.settings.logo_width }}px, 220px);

  height: auto;

  max-height: 58px;

  object-fit: contain;
}


.apex-mobile-menu__nav {
  flex: 1;

  display: flex;

  align-items: center;
}


.apex-mobile-menu__list {
  list-style: none;

  width: 100%;

  padding: 0;
  margin: 0;
}


.apex-mobile-menu__item {
  border-bottom: 1px solid var(--color-border, #222);
}


.apex-mobile-menu__link {
  display: flex;

  align-items: center;

  min-height: 72px;

  color: #ffffff;

  text-decoration: none;

  font-size: clamp(28px, 9vw, 44px);

  font-weight: 700;

  line-height: 1;

  letter-spacing: .04em;

  text-transform: uppercase;
}


.apex-mobile-menu__footer {
  padding-top: 20px;

  border-top: 1px solid var(--color-border, #222);
}


.apex-mobile-menu__account {
  color: #ffffff;

  text-decoration: none;

  text-transform: uppercase;

  font-size: 14px;

  font-weight: 600;

  letter-spacing: .14em;
}



/* =========================
   LAPTOP
========================== */

@media screen and (max-width: 1180px) and (min-width: 990px) {

  .apex-header__container {
    padding: 0 28px;
  }


  .apex-header__inner {
    column-gap: 18px;
  }


  .apex-header__logo-image {
    max-width: 220px;
  }


  .apex-header__nav-list {
    gap: 26px;
  }


  .apex-header__nav-link {
    font-size: 12px;
  }


  .apex-header__actions {
    gap: 4px;
  }

}



/* =========================
   MOBILE
========================== */

@media screen and (max-width: 989px) {

  .apex-header {
    height: 72px;
  }


  .apex-header__container {
    padding: 0 16px;
  }


  .apex-header__inner {
    min-height: 72px;

    grid-template-columns: 1fr auto 1fr;

    column-gap: 8px;
  }


  .apex-header__menu-button {
    display: inline-flex;

    justify-self: start;
  }


  .apex-header__logo {
    justify-self: center;
  }


  .apex-header__logo-image {
    width: min({{ section.settings.logo_width }}px, 165px);

    max-height: 42px;
  }


  .apex-header__logo-text {
    font-size: 22px;
  }


  .apex-header__nav {
    display: none;
  }


  .apex-header__actions {
    gap: 0;
  }


  .apex-header__account {
    display: none;
  }


  .apex-header__icon {
    width: 40px;
    height: 40px;
  }


  .apex-header__icon svg {
    width: 21px;
    height: 21px;
  }


  .apex-header__cart-count {
    top: 0;
    right: -1px;

    min-width: 17px;
    height: 17px;

    font-size: 9px;
  }

}



@media screen and (max-width: 420px) {

  .apex-header__container {
    padding: 0 10px;
  }


  .apex-header__inner {
    column-gap: 4px;
  }


  .apex-header__logo-image {
    width: min({{ section.settings.logo_width }}px, 135px);
  }


  .apex-header__actions .apex-header__icon {
    width: 38px;
  }

}

</style>



<script>

document.addEventListener('DOMContentLoaded', function () {


  /* =========================
     MOBILE MENU
  ========================== */

  const menuButton =
    document.querySelector('.apex-header__menu-button');

  const closeButton =
    document.querySelector('.apex-mobile-menu__close');

  const mobileMenu =
    document.getElementById('ApexMobileMenu');


  if (
    menuButton &&
    closeButton &&
    mobileMenu
  ) {


    function openMenu() {

      mobileMenu.classList.add('is-open');

      mobileMenu.setAttribute(
        'aria-hidden',
        'false'
      );

      menuButton.setAttribute(
        'aria-expanded',
        'true'
      );

      document.body.style.overflow = 'hidden';

    }


    function closeMenu() {

      mobileMenu.classList.remove('is-open');

      mobileMenu.setAttribute(
        'aria-hidden',
        'true'
      );

      menuButton.setAttribute(
        'aria-expanded',
        'false'
      );

      document.body.style.overflow = '';

    }


    menuButton.addEventListener(
      'click',
      openMenu
    );


    closeButton.addEventListener(
      'click',
      closeMenu
    );


    mobileMenu
      .querySelectorAll('a')
      .forEach(function (link) {

        link.addEventListener(
          'click',
          closeMenu
        );

      });


    document.addEventListener(
      'keydown',
      function (event) {

        if (
          event.key === 'Escape' &&
          mobileMenu.classList.contains('is-open')
        ) {

          closeMenu();

        }

      }
    );

  }



  /* =========================
     LIVE CART COUNT
  ========================== */

  let apexCartUpdateTimer = null;


  async function updateApexCartCount() {

    try {

      const response = await fetch(
        window.Shopify.routes.root + 'cart.js',
        {
          headers: {
            Accept: 'application/json'
          }
        }
      );


      if (!response.ok) return;


      const cart =
        await response.json();


      const badge =
        document.getElementById('ApexCartCount');


      if (!badge) return;


      if (cart.item_count > 0) {

        badge.textContent =
          cart.item_count;

        badge.classList.remove(
          'is-hidden'
        );

      } else {

        badge.textContent = '';

        badge.classList.add(
          'is-hidden'
        );

      }

    } catch (error) {

      console.error(
        'APEX cart count update failed:',
        error
      );

    }

  }



  function scheduleApexCartCountUpdate(
    delay = 150
  ) {

    clearTimeout(
      apexCartUpdateTimer
    );


    apexCartUpdateTimer =
      setTimeout(
        updateApexCartCount,
        delay
      );

  }



  /* INITIAL COUNT */

  updateApexCartCount();



  /* =========================
     CART EVENTS
  ========================== */

  [
    'cart:updated',
    'cart:refresh',
    'cart:change',
    'cart:update',
    'cart-drawer:updated',
    'cart-drawer:refresh',
    'product:added'
  ].forEach(function (eventName) {

    document.addEventListener(
      eventName,
      function () {

        scheduleApexCartCountUpdate(100);

      }
    );

  });



  /* =========================
     WATCH AJAX CART REQUESTS
  ========================== */

  const apexOriginalFetch =
    window.fetch;


  window.fetch =
    async function () {

      const response =
        await apexOriginalFetch.apply(
          this,
          arguments
        );


      try {

        const request =
          arguments[0];


        const url =
          typeof request === 'string'
            ? request
            : request && request.url
              ? request.url
              : '';


        if (
          url.includes('/cart/add') ||
          url.includes('/cart/change') ||
          url.includes('/cart/update') ||
          url.includes('/cart/clear')
        ) {

          if (response.ok) {

            scheduleApexCartCountUpdate(100);


            setTimeout(
              updateApexCartCount,
              400
            );

          }

        }

      } catch (error) {

        console.error(
          'APEX cart listener error:',
          error
        );

      }


      return response;

    };



  /* =========================
     PLUS / MINUS / REMOVE
  ========================== */

  document.addEventListener(
    'click',
    function (event) {

      const control =
        event.target.closest(
          [
            '.quantity-btn',
            '.quantity__button',
            '[name="plus"]',
            '[name="minus"]',
            '[data-quantity-plus]',
            '[data-quantity-minus]',
            '[data-cart-remove]',
            '.cart-remove-button',
            '.cart-item__remove',
            'button[name="add"]',
            '.add-to-cart-submit',
            '.product-form__submit'
          ].join(',')
        );


      if (!control) return;


      scheduleApexCartCountUpdate(
        300
      );


      setTimeout(
        updateApexCartCount,
        700
      );

    }
  );



  /* =========================
     DIRECT QUANTITY CHANGE
  ========================== */

  document.addEventListener(
    'change',
    function (event) {

      const quantityInput =
        event.target.closest(
          'input[name="updates[]"], input[name="quantity"], .quantity__input, .quantity-field'
        );


      if (!quantityInput) return;


      scheduleApexCartCountUpdate(
        300
      );


      setTimeout(
        updateApexCartCount,
        700
      );

    }
  );

});

</script>



{% schema %}
{
  "name": "APEX Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 400,
      "step": 10,
      "default": 240,
      "unit": "px",
      "label": "Logo width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Main menu"
    }
  ],
  "presets": [
    {
      "name": "APEX Header"
    }
  ]
}
{% endschema %}