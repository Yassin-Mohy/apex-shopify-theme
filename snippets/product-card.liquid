<div class="product-card">
  <a href="{{ product.url }}" class="product-card__link">
    <div class="product-card__image-wrapper image-zoom-container">
      {%- if product.featured_media -%}
        <img src="{{ product.featured_media | image_url: width: 600 }}" 
             alt="{{ product.featured_media.alt | escape }}" 
             class="product-card__image {% if product.media[1] %}has-hover{% endif %}"
             loading="lazy"
             width="{{ product.featured_media.width }}"
             height="{{ product.featured_media.height }}">
        
        {%- if product.media[1] -%}
          <img src="{{ product.media[1] | image_url: width: 600 }}" 
               alt="{{ product.media[1].alt | escape }}" 
               class="product-card__image-hover"
               loading="lazy"
               width="{{ product.media[1].width }}"
               height="{{ product.media[1].height }}">
        {%- endif -%}
      {%- endif -%}
      
      <div class="product-card__badges">
        {%- if product.available == false -%}
          <span class="badge badge--soldout">{{ 'products.product.sold_out' | t | default: 'SOLD OUT' }}</span>
        {%- elsif product.compare_at_price > product.price -%}
          <span class="badge badge--sale">{{ 'products.product.on_sale' | t | default: 'SALE' }}</span>
        {%- endif -%}
      </div>
    </div>
  </a>

  <div class="product-card__info">
    <a href="{{ product.url }}" class="product-card__title h6">{{ product.title }}</a>
    
    <div class="product-card__price-wrapper">
      {% render 'price', product: product %}
    </div>

    {%- if settings.enable_quick_add -%}
      <div class="product-card__quick-add">
        {%- if product.has_only_default_variant -%}
          <product-form>
            <form method="post" action="{{ routes.cart_add_url }}" id="quick-add-{{ product.id }}" accept-charset="UTF-8" class="form" enctype="multipart/form-data" novalidate="novalidate">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="button button--secondary button--full-width" {% unless product.available %}disabled{% endunless %}>
                {%- if product.available -%}
                  + ADD TO CART
                {%- else -%}
                  SOLD OUT
                {%- endif -%}
              </button>
            </form>
          </product-form>
        {%- else -%}
          <a href="{{ product.url }}" class="button button--secondary button--full-width">
            SELECT SIZE
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .product-card__link {
    display: block;
    margin-bottom: 1.5rem;
  }
  .product-card__image-wrapper {
    position: relative;
    aspect-ratio: 3/4;
    background-color: var(--color-border);
    border-radius: var(--border-radius);
  }
  .product-card__image,
  .product-card__image-hover {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-card__image-hover {
    opacity: 0;
    transition: opacity var(--transition-default);
  }
  .product-card__image-wrapper:hover .product-card__image-hover {
    opacity: 1;
  }
  .product-card__badges {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    z-index: 2;
  }
  .badge {
    padding: 0.4rem 0.8rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    border-radius: 2px;
  }
  .badge--soldout {
    background-color: var(--color-border);
    color: var(--color-text-secondary);
  }
  .badge--sale {
    background-color: var(--color-text);
    color: var(--color-background);
  }
  .product-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .product-card__title {
    margin: 0;
    font-size: 1.4rem;
    letter-spacing: 0.05em;
  }
  .product-card__title:hover {
    text-decoration: underline;
  }
  .product-card__quick-add {
    margin-top: 1rem;
  }
  .button--full-width {
    width: 100%;
    padding: 1rem;
    min-height: 4rem;
    font-size: 1.2rem;
  }
</style>
