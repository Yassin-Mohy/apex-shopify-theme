<div class="social-icons-wrapper">
  {%- if settings.social_instagram_link != blank -%}
    <a href="{{ settings.social_instagram_link }}" class="social-icon-link" target="_blank" rel="noopener" aria-describedby="a11y-new-window-message">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon icon-instagram">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
      </svg>
      <span class="visually-hidden">Instagram</span>
    </a>
  {%- endif -%}

  {%- if settings.social_tiktok_link != blank -%}
    <a href="{{ settings.social_tiktok_link }}" class="social-icon-link" target="_blank" rel="noopener" aria-describedby="a11y-new-window-message">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tiktok">
        <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
      </svg>
      <span class="visually-hidden">TikTok</span>
    </a>
  {%- endif -%}
</div>

<style>
  .social-icons-wrapper {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }
  .social-icon-link {
    color: var(--color-text-secondary);
    transition: color var(--transition-default);
  }
  .social-icon-link:hover {
    color: var(--color-text);
  }
  .social-icon-link svg {
    width: 20px;
    height: 20px;
  }
</style>
